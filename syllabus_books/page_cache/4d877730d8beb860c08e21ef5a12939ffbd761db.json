>\n                                                                                        <td class=\"views-field views-field-field-session-display-number\">Lecture 12          </td>\n                                                                                        <td class=\"views-field views-field-field-session-display-title\"><a href=\"/economics/econ-252-11/lecture-12\" hreflang=\"en\">Misbehavior, Crises, Regulation and Self Regulation</a>          </td>\n              </tr>\n          <tr>\n                                                                                        <td class=\"views-field views-field-field-session-display-number\">Lecture 13          </td>\n                                                                                        <td class=\"views-field views-field-field-session-display-title\"><a href=\"/economics/econ-252-11/lecture-13\" hreflang=\"en\">Banks</a>          </td>\n              </tr>\n          <tr>\n                                                                                        <td class=\"views-field views-field-field-session-display-number\">Lecture 14          </td>\n                                                                                        <td class=\"views-field views-field-field-session-display-title\"><a href=\"/economics/econ-252-11/lecture-14\" hreflang=\"en\">Guest Speaker Maurice &quot;Hank&quot; Greenberg</a>          </td>\n              </tr>\n          <tr>\n                                                                                        <td class=\"views-field views-field-field-session-display-number\">Lecture 15          </td>\n                                                                                        <td class=\"views-field views-field-field-session-display-title\"><a href=\"/economics/econ-252-11/lecture-15\" hreflang=\"en\">Forward and Futures Markets</a>          </td>\n              </tr>\n          <tr>\n                                          
{"status": 200, "text": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\" />\n<meta name=\"Generator\" content=\"Drupal 10 (https://www.drupal.org)\" />\n<meta name=\"MobileOptimized\" content=\"width\" />\n<meta name=\"HandheldFriendly\" content=\"true\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<link rel=\"icon\" href=\"/themes/custom/yale_oyc/favicon.ico\" type=\"image/vnd.microsoft.icon\" />\n<link rel=\"canonical\" href=\"https://oyc.yale.edu/philosophy/phil-181\" />\n<link rel=\"shortlink\" href=\"https://oyc.yale.edu/node/689\" />\n\n    <title>Philosophy and the Science of Human Nature | Open Yale Courses</title>\n    <link rel=\"stylesheet\" media=\"all\" href=\"/sites/default/files/css/css_La4FEjoM2DM1_88ZEQCQ9vD8MFpcLlOkLOyWQiRD8cQ.css?delta=0&amp;language=en&amp;theme=yale_oyc&amp;include=eJxNjFEOwjAMQy9UkR_uM6WdhaK1DSQZ2zg9AyTUH8t-enLRqpZ1J-zc7hXXVNRAXa1xlRfSY5WyBGenfxvYJzJbcglsMmPiCguSLpE82AK2SFBmx7gb3PkGH1nX-XQOD7Sf_xRsTt-8NJ3XinSc95MehRpLfwPzq0lH\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/sites/default/files/css/css_7LhbAw7mF2ro-gX7BmanjZPpAuRX5IGqRe48UKIFGVc.css?delta=1&amp;language=en&amp;theme=yale_oyc&amp;include=eJxNjFEOwjAMQy9UkR_uM6WdhaK1DSQZ2zg9AyTUH8t-enLRqpZ1J-zc7hXXVNRAXa1xlRfSY5WyBGenfxvYJzJbcglsMmPiCguSLpE82AK2SFBmx7gb3PkGH1nX-XQOD7Sf_xRsTt-8NJ3XinSc95MehRpLfwPzq0lH\" />\n\n      \n        </head>\n<body class=\"path-node page-node-type-course\">\n<a href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n  Skip to main content\n</a>\n<div data-sitewide-alert></div>\n  <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    \n\n\t<div class=\"overlay\"></div>\n<div\n\tclass=\"layout-container has-sidebar\">\n\n\t\t\n\t<header role=\"banner\" class=\"header\">\n\t\t<div class=\"header__top\">\n\t\t\t<div class=\"header__top-inner\">\n\t\t\t\t<div class=\"header__top-first\">\n\t\t\t\t\t<div class=\"topper-logo\">\n\t\t